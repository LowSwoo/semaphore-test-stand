# Settings of the SSO stand (sso_stand/do). Copy to .env and fill in.
# LDAP / Dex fixture secrets have defaults in do/variables.tf and are not needed here.
TF_VAR_semaphore_version="2.20.16-beta8"
TF_VAR_parent_domain="domain.com"

TF_VAR_ssh_key_name="my-key"

TF_VAR_db_password="change-me-postgres"
TF_VAR_semaphore_admin_password="change-me-admin"
# head -c32 /dev/urandom | base64
TF_VAR_semaphore_cookie_hash="<base64 32 bytes>"
TF_VAR_semaphore_cookie_encryption="<base64 32 bytes>"
TF_VAR_semaphore_access_key_encryption="<base64 32 bytes>"

TF_VAR_cloudflare_api_token="cfat_..."
TF_VAR_do_token="dop_v1_..."
