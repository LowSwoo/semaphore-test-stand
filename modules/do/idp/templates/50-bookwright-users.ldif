dn: ou=people,dc=bookwright,dc=test
objectClass: organizationalUnit
ou: people

dn: uid=ldap.user,ou=people,dc=bookwright,dc=test
objectClass: inetOrgPerson
uid: ldap.user
cn: LDAP Test User
sn: User
mail: ldap.user@bookwright.test
userPassword: Bookwright-LDAP-42!

dn: uid=ldap.invalid,ou=people,dc=bookwright,dc=test
objectClass: inetOrgPerson
uid: ldap.invalid
cn: LDAP Invalid Password User
sn: User
mail: ldap.invalid@bookwright.test
userPassword: Bookwright-LDAP-Invalid-42!

dn: uid=ldap-admin-conflict,ou=people,dc=bookwright,dc=test
objectClass: inetOrgPerson
uid: ldap-admin-conflict
cn: LDAP Local Account Conflict
sn: Conflict
mail: admin@localhost
userPassword: Bookwright-LDAP-Conflict-42!

# Same login and email in every provider of the stand (account matching checks).
dn: uid=john.user,ou=people,dc=bookwright,dc=test
objectClass: inetOrgPerson
uid: john.user
cn: John User
sn: User
mail: john.user@semaphore.test
userPassword: John-User-42!

# Groups. osixia/openldap enables the memberof overlay for groupOfUniqueNames /
# uniqueMember, so members also get a memberOf attribute pointing here.
dn: ou=groups,dc=bookwright,dc=test
objectClass: organizationalUnit
ou: groups

dn: cn=devops,ou=groups,dc=bookwright,dc=test
objectClass: groupOfUniqueNames
cn: devops
uniqueMember: uid=ldap.user,ou=people,dc=bookwright,dc=test
uniqueMember: uid=ldap.invalid,ou=people,dc=bookwright,dc=test
uniqueMember: uid=ldap-admin-conflict,ou=people,dc=bookwright,dc=test
uniqueMember: uid=john.user,ou=people,dc=bookwright,dc=test
