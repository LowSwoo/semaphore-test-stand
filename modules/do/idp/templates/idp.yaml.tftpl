#cloud-config
# Identity providers of the SSO stand, run with Docker Compose on one droplet:
#   ldap     - OpenLDAP dc=bookwright,dc=test (plain LDAP :389, VPC only, see main.tf)
#   ldap2    - second OpenLDAP dc=marlowe,dc=test (plain LDAP :390, VPC only)
#   dex      - Dex OIDC provider, behind a proxied Cloudflare record
#   keycloak - Keycloak OIDC provider (dev mode, realm imported at first start)
#   proxy    - Caddy on :80 routing dex/keycloak by hostname (Caddyfile.tftpl)
# They are independent login methods; Dex has no LDAP connector. Images,
# directory and users of LDAP and Dex come from the integration-tests fixtures
# (profiles/feature-ldap-tls, profiles/feature-oidc-local).
package_update: true
package_upgrade: false
packages:
  - docker.io
  - docker-compose-v2

write_files:
  - path: /opt/idp/docker-compose.yml
    permissions: "0600"
    content: |
      services:
%{ if ldap_enabled ~}
        ldap:
          image: osixia/openldap:1.5.0
          hostname: ldap
          restart: unless-stopped
          ports:
            - "389:389"
          environment:
            LDAP_ORGANISATION: Bookwright
            LDAP_DOMAIN: bookwright.test
            LDAP_BASE_DN: ${ldap_base_dn}
            LDAP_ADMIN_PASSWORD: "${ldap_admin_password}"
            LDAP_TLS: "false"
            LDAP_REMOVE_CONFIG_AFTER_SETUP: "false"
          volumes:
            - /opt/idp/ldif:/container/service/slapd/assets/config/bootstrap/ldif/custom
            - ldap-data:/var/lib/ldap
            - ldap-config:/etc/ldap/slapd.d
          healthcheck:
            test: ["CMD-SHELL", "ldapsearch -x -H ldap://localhost:389 -D '${ldap_bind_dn}' -w \"$$LDAP_ADMIN_PASSWORD\" -b '${ldap_base_dn}' -s base >/dev/null"]
            interval: 2s
            timeout: 3s
            retries: 30
%{ endif ~}
%{ if ldap2_enabled ~}
        ldap2:
          image: osixia/openldap:1.5.0
          hostname: ldap2
          restart: unless-stopped
          ports:
            - "${ldap2_port}:389"
          environment:
            LDAP_ORGANISATION: Marlowe
            LDAP_DOMAIN: marlowe.test
            LDAP_BASE_DN: ${ldap2_base_dn}
            LDAP_ADMIN_PASSWORD: "${ldap2_admin_password}"
            LDAP_TLS: "false"
            LDAP_REMOVE_CONFIG_AFTER_SETUP: "false"
          volumes:
            - /opt/idp/ldif2:/container/service/slapd/assets/config/bootstrap/ldif/custom
            - ldap2-data:/var/lib/ldap
            - ldap2-config:/etc/ldap/slapd.d
          healthcheck:
            test: ["CMD-SHELL", "ldapsearch -x -H ldap://localhost:389 -D '${ldap2_bind_dn}' -w \"$$LDAP_ADMIN_PASSWORD\" -b '${ldap2_base_dn}' -s base >/dev/null"]
            interval: 2s
            timeout: 3s
            retries: 30
%{ endif ~}
%{ if dex_enabled ~}
        dex:
          image: ghcr.io/dexidp/dex:v2.45.1-alpine
          command: ["dex", "serve", "/etc/dex/config.yaml"]
          restart: unless-stopped
          volumes:
            - /opt/idp/dex.yaml:/etc/dex/config.yaml:ro
            - dex-data:/var/dex
          healthcheck:
            test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:5556/dex/.well-known/openid-configuration >/dev/null"]
            interval: 2s
            timeout: 2s
            retries: 30
%{ endif ~}
%{ if keycloak_enabled ~}
        keycloak:
          image: quay.io/keycloak/keycloak:26.4
          command: ["start-dev", "--import-realm"]
          restart: unless-stopped
          environment:
            KC_BOOTSTRAP_ADMIN_USERNAME: admin
            KC_BOOTSTRAP_ADMIN_PASSWORD: "${keycloak_admin_password}"
            # Public URL; Caddy forwards X-Forwarded-Proto https from the edge.
            KC_HOSTNAME: https://${keycloak_hostname}
            KC_HTTP_ENABLED: "true"
            KC_PROXY_HEADERS: xforwarded
            KC_HEALTH_ENABLED: "true"
          volumes:
            - /opt/idp/keycloak/bookwright-realm.json:/opt/keycloak/data/import/bookwright-realm.json:ro
            # Whole data dir, not data/h2: the volume inherits the image's
            # keycloak-owned mode only for a path that exists in the image;
            # a fresh mount point is created root-owned and uid 1000 cannot
            # write the H2 files.
            - keycloak-data:/opt/keycloak/data
          healthcheck:
            # The image has bash but no curl/wget; management port 9000.
            test:
              - CMD
              - bash
              - -c
              - exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.0\r\n\r\n' >&3 && read -r -d '' r <&3; [[ "$$r" == *'"UP"'* ]]
            interval: 5s
            timeout: 5s
            start_period: 180s
            retries: 60
%{ endif ~}
%{ if web_enabled ~}
        proxy:
          image: caddy:2-alpine
          restart: unless-stopped
          ports:
            - "80:80"
          volumes:
            - /opt/idp/Caddyfile:/etc/caddy/Caddyfile:ro
%{ endif ~}
      volumes:
%{ if ldap_enabled ~}
        ldap-data:
        ldap-config:
%{ endif ~}
%{ if ldap2_enabled ~}
        ldap2-data:
        ldap2-config:
%{ endif ~}
%{ if dex_enabled ~}
        dex-data:
%{ endif ~}
%{ if keycloak_enabled ~}
        keycloak-data:
%{ endif ~}
%{ if ldap_enabled ~}
  - path: /opt/idp/ldif/50-bookwright-users.ldif
    permissions: "0644"
    content: |
      ${indent(6, ldap_users_ldif)}
%{ endif ~}
%{ if ldap2_enabled ~}
  - path: /opt/idp/ldif2/50-marlowe-users.ldif
    permissions: "0644"
    content: |
      ${indent(6, ldap2_users_ldif)}
%{ endif ~}
%{ if dex_enabled ~}
  - path: /opt/idp/dex.yaml
    # Read by the dex user (uid 1001) inside the container.
    permissions: "0644"
    content: |
      ${indent(6, dex_config)}
%{ endif ~}
%{ if keycloak_enabled ~}
  - path: /opt/idp/keycloak/bookwright-realm.json
    # Read by the keycloak user (uid 1000) inside the container.
    permissions: "0644"
    content: |
      ${indent(6, keycloak_realm_json)}
%{ endif ~}
%{ if web_enabled ~}
  - path: /opt/idp/Caddyfile
    permissions: "0644"
    content: |
      ${indent(6, caddyfile)}
%{ endif ~}

runcmd:
  - systemctl enable --now docker
  - docker compose -f /opt/idp/docker-compose.yml up -d --wait
