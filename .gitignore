/semaphore_test_stand
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
terraform.tfvars
*.tfplan
.terraform.tfstate.lock.info
admin.token
# Shared tfvars hold secrets; commit only the .example versions.
*.tfvars
.env
.env.*
!*.example
# Per-stand configs: workspaces/<name>/config.yml holds the subscription key.
# Ignore everything under workspaces/ except the README and the template.
# To commit a stand directory deliberately, add `!/workspaces/<name>/`.
/workspaces/*
!/workspaces/README.md
!/workspaces/example/
# Never commit generated secrets, even inside allowed directories.
/workspaces/**/admin.token
/workspaces/**/id_rsa
