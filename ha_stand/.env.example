TF_VAR_semaphore_version="2.20.16-beta5"
TF_VAR_parent_domain="domain.com"

TF_VAR_ssh_key_name="fiftin2"

TF_VAR_db_password="change-me-postgres"
TF_VAR_redis_password="change-me-redis"
TF_VAR_redis_sentinel_password="change-me-sentinel"
TF_VAR_semaphore_admin_password="change-me-admin"
TF_VAR_semaphore_cookie_hash="+lRKN9gsv77gTNZQUghskEh8I0pJh4ejKuKxJqFb3lo="
TF_VAR_semaphore_cookie_encryption="FQR1/5H9tqFN2i/QW6c/k7sp1Hs4ybqaeLIp9CkIqiU="
TF_VAR_semaphore_access_key_encryption="azTfbQpcVmKjCrqWCScD0A3EhjL+DYv7COCL8JiREuk="

TF_VAR_cloudflare_api_token="cfat_..."
TF_VAR_do_token="dop_v1_..."

# Cloudflare R2 (S3 API): the server module uploads the admin token here, the
# runner module reads it. Create an R2 API token with Object Read & Write and
# bucket creation rights; the endpoint is https://<account_id>.r2.cloudflarestorage.com.
# Leave s3_endpoint empty (and set a real region) to use AWS S3 instead. The
# bucket name defaults to "<workspace>-semaphore-stand".
TF_VAR_s3_endpoint="https://<account_id>.r2.cloudflarestorage.com"
TF_VAR_aws_access_key="<r2 access key id>"
TF_VAR_aws_secret_key="<r2 secret access key>"
TF_VAR_aws_region="auto"
# TF_VAR_s3_bucket="my-semaphore-stand"
# R2 does not accept the AWS SDK's default request checksums; these are read by
# the SDK inside the Terraform AWS provider (not TF_VAR_*, plain env vars).
AWS_REQUEST_CHECKSUM_CALCULATION="when_required"
AWS_RESPONSE_CHECKSUM_VALIDATION="when_required"
TF_VAR_do_k8s_cluster="..."